#
# SYS5 Startup script for ntpd
# By Luis Enrique Limon,  2026
NTPD=/usr/local/lse/bin/ntpd
NTPDATE=/usr/local/lse/bin/ntpdate 
NTPCONF=/usr/local/lse/etc/ntp.conf
PIDFILE=/var/run/ntpd.pid

case "$1" in
'start')
        if [ -f "$NTPD" -a -f "$NTPCONF" ]; then
                echo "Syncing initial time with ntpdate..."
                if [ -f "$NTPDATE" ]; then
                        # Extract first server or peer directive from ntp.conf (ignoring comments)
                        NTPSERVER=`/usr/bin/awk '/^[ \t]*(server|peer)[ \t]+/ {print $2; exit}' $NTPCONF`
                        
                        if [ -n "$NTPSERVER" ]; then
                                echo "  Using initial server from $NTPCONF:$NTPSERVER"
                                $NTPDATE -u -b$NTPSERVER >/dev/null 2>&1
                        else
                                echo "  No server found in $NTPCONF, using fallback pool..."
                                $NTPDATE -u -b 0.pool.ntp.org >/dev/null 2>&1
                        fi
                fi

                echo "Starting NTP daemon..."
                $NTPD -g -p $PIDFILE -c$NTPCONF
        else
                echo "NTP setup incomplete. Check $NTPD and $NTPCONF"
                exit 1
        fi
        ;;
'stop')
        if [ -f "$PIDFILE" ]; then
                echo "Stopping NTP daemon..."
                kill `cat $PIDFILE`
                rm -f $PIDFILE
        else
                # Fallback process search for Solaris 2.5.1
                pid=`/usr/bin/ps -ef | /usr/bin/grep ntpd | /usr/bin/grep -v grep | /usr/bin/awk '{print $2}'`
                if [ -n "$pid" ]; then
                        echo "Stopping NTP daemon (PID $pid)..."
                        kill $pid
                else
                        echo "NTP daemon not running."
                fi
        fi
        ;;

'restart')
        $0 stop
        sleep 2
        $0 start
        ;;

*)
        echo "Usage: $0 { start | stop | restart }"
        exit 1
        ;;
esac

exit 0
